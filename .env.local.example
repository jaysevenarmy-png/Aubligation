# Copy to .env.local and fill in your values

# Game start date (ISO format). Leave empty or set to a past date to open immediately.
NEXT_PUBLIC_GAME_START_DATE=2026-07-31T22:00:00Z

# Supabase (optional — app works with localStorage without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
